# Copie para .env.local e preencha com as credenciais do projeto Supabase
# (Supabase Dashboard > Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado com a rota /api/cron/* — a Vercel envia
# "Authorization: Bearer <CRON_SECRET>" ao chamar os cron jobs.
CRON_SECRET=

# Envio de e-mail (SMTP da conta Google/Workspace crm@granvale.com.br — exige
# verificação em 2 etapas + "Senha de app" gerada em myaccount.google.com).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=crm@granvale.com.br
SMTP_PASSWORD=

# Segredo compartilhado com o Supabase Database Webhook (Database > Webhooks)
# configurado na tabela notificacoes — enviado como header
# "Authorization: Bearer <SUPABASE_WEBHOOK_SECRET>" pelo próprio webhook.
SUPABASE_WEBHOOK_SECRET=

# Sincronização de Ações com o Google Calendar — Service Account com
# delegação em todo o domínio (Workspace granvale.com.br > Admin Console >
# Segurança > Controle de acesso a dados > Delegação em todo o domínio,
# escopo https://www.googleapis.com/auth/calendar.events). Valores vêm do
# JSON da chave da Service Account (Google Cloud Console > Credenciais).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Rota /api/cron/backup-producao: pra onde o snapshot diário dos dados de
# produção é enviado (bucket "backups-producao") — de propósito, um projeto
# Supabase DIFERENTE do de produção (ex: o projeto Dev), pra não guardar o
# backup no mesmo lugar que ele protege. Só precisa estar configurado no
# ambiente de Produção da Vercel, não em dev/local.
BACKUP_STORAGE_SUPABASE_URL=
BACKUP_STORAGE_SUPABASE_SERVICE_KEY=
